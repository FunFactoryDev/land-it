#!/usr/bin/env python3
"""land-it: the deterministic half of the pre-PR pipeline.

Checks, the tree-bound stamp and the hooks live here; judgment (what to
review, how to fix) lives in the skills. Stdlib only, Python 3.9+.
"""
import argparse
import contextlib
import datetime
import functools
import hashlib
import json
import os
import posixpath
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

try:
    import fcntl
except ImportError:  # ponytail: no state lock on Windows; parallel hooks may drop a dirty mark
    fcntl = None

CONFIG = ".claude/land-it.json"
TAIL = 4000  # chars of failing output handed back to Claude
MAX_STOP_BLOCKS = 3
DAY = 86400


def die(msg):
    sys.exit("land-it: " + msg)


def git(root, *args, env=None, check=True, raw=False):
    r = subprocess.run(["git", *args], cwd=root, env=env, capture_output=True, text=True)
    if check and r.returncode:
        die("git %s: %s" % (" ".join(args), r.stderr.strip()))
    return (r.stdout if raw else r.stdout.strip()) if r.returncode == 0 else ""


def nul_paths(out, status=False):
    """Paths from git's -z output: no quoting, so Unicode and odd names survive. With --name-status,
    a rename or copy yields both paths, so moving a file out of a high-risk area still counts the area."""
    toks, paths, i = out.split("\0"), [], 0
    while i < len(toks) and toks[i]:
        n = 1
        if status:
            n = 2 if toks[i][:1] in "RC" else 1
            i += 1
        paths += toks[i:i + n]
        i += n
    return paths


def diff_paths(root, *revs):
    return nul_paths(git(root, "diff", "--name-status", "-z", "-M", *revs, check=False, raw=True), status=True)


def find_root(cwd):
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def load_config(root):
    path = os.path.join(root, CONFIG)
    if not os.path.exists(path):
        return None
    with open(path) as f:
        try:
            cfg = json.load(f)
        except ValueError as e:
            die("%s isn't valid JSON: %s" % (CONFIG, e))
    if not isinstance(cfg, dict):
        die("%s must be a JSON object" % CONFIG)
    return cfg


def tail(text, n=TAIL):
    return text if len(text) <= n else "...\n" + text[-n:]


# --- trust: config commands run only after the user approves them ----------------
# Without this, an edit to the config (say by Claude under prompt injection, in a mode
# that auto-accepts edits) would turn into command execution through the hooks.

def trust_file():
    return os.path.join(os.environ.get("LAND_IT_HOME") or os.path.expanduser("~/.land-it"), "trust.json")


def commands_digest(cfg):
    blob = json.dumps({"checks": cfg.get("checks") or {}, "on_edit": cfg.get("on_edit") or {}}, sort_keys=True)
    return hashlib.sha256(blob.encode()).hexdigest()


def trust_store():
    try:
        with open(trust_file()) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return {}


def is_trusted(root, cfg):
    if not (cfg.get("checks") or cfg.get("on_edit")):
        return True
    return trust_store().get(os.path.realpath(root)) == commands_digest(cfg)


def record_trust(root, cfg):
    store = trust_store()
    store[os.path.realpath(root)] = commands_digest(cfg)
    os.makedirs(os.path.dirname(trust_file()), exist_ok=True)
    with open(trust_file() + ".tmp", "w") as f:
        json.dump(store, f, indent=1)
    os.replace(trust_file() + ".tmp", trust_file())


def command_lines(cfg):
    return (["check %s: %s" % (name, cmd) for name, cmd, _ in check_specs(cfg)]
            + ["on_edit %s: %s" % (g, c) for g, c in (cfg.get("on_edit") or {}).items()])


def untrusted_message(cfg):
    return ("land-it: the commands in %s are new or changed since they were last trusted, so they didn't run:\n  %s\n"
            "Review them, then type /land-it:trust. Only the user can; Claude can't approve them."
            % (CONFIG, "\n  ".join(command_lines(cfg))))


# --- globs -----------------------------------------------------------------

@functools.lru_cache(maxsize=None)
def glob_re(pat):
    """gitignore-ish: `*` stays in a segment, `**` spans, `{a,b}` alternates,
    no slash means any depth, a match on a directory covers what's under it."""
    if "/" not in pat:
        pat = "**/" + pat
    out, i, depth = "", 0, 0
    while i < len(pat):
        if pat.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
            continue
        if pat.startswith("**", i):
            out, i = out + ".*", i + 2
            continue
        c = pat[i]
        if c == "*":
            out += "[^/]*"
        elif c == "?":
            out += "[^/]"
        elif c == "{":
            out, depth = out + "(?:", depth + 1
        elif c == "}" and depth:
            out, depth = out + ")", depth - 1
        elif c == "," and depth:
            out += "|"
        else:
            out += re.escape(c)
        i += 1
    return re.compile(out + r"(?:/.*)?\Z")


def matches(pat, path):
    return bool(glob_re(pat.rstrip("/")).match(path))


# --- state (per worktree, inside the git dir: never committed) ---------------

def state_dir(root):
    return os.path.join(git(root, "rev-parse", "--absolute-git-dir"), "land-it")


def load_state(root, name="state.json"):
    try:
        with open(os.path.join(state_dir(root), name)) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


@contextlib.contextmanager
def locked_state(root, name="state.json"):
    d = state_dir(root)
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "lock"), "w") as lock:
        if fcntl:
            fcntl.flock(lock, fcntl.LOCK_EX)
        st = load_state(root, name)
        yield st
        path = os.path.join(d, name)
        with open(path + ".tmp", "w") as f:
            json.dump(st, f, indent=1)
        os.replace(path + ".tmp", path)


def worktree_tree(root):
    """Tree hash of the working tree as it would be committed with `git add -A`."""
    with tempfile.TemporaryDirectory() as d:
        idx = os.path.join(d, "index")
        src = os.path.join(git(root, "rev-parse", "--absolute-git-dir"), "index")
        if os.path.exists(src):
            # copy2 keeps the index mtime: git's racy-entry check depends on it, and a
            # fresh mtime makes a same-size edit in the same second look unchanged
            shutil.copy2(src, idx)
        env = dict(os.environ, GIT_INDEX_FILE=idx)
        git(root, "add", "-A", env=env)
        return git(root, "write-tree", env=env)


def head_tree(root):
    return git(root, "rev-parse", "HEAD^{tree}", check=False)


# --- risk: the change sets the tier, not the author -----------------------------

TIERS = ["low", "medium", "high"]
# Config can't lower these: CI and the gate's own config decide what every other change must pass.
ALWAYS_HIGH = [".github/workflows/**", ".gitlab-ci.yml", "CODEOWNERS", CONFIG]
DEFAULT_RISK = {"medium": ["CLAUDE.md", "REVIEW.md", ".claude/**"], "low": ["*.md", "docs/**", "LICENSE*"]}
# /code-review effort per tier, the repo's Quick/Standard/Deep. `max` fans out to dozens of
# agents (40+ minutes even on a tiny diff), so it's opt-in through `review_effort`.
REVIEW_EFFORT = {"low": "low", "medium": "medium", "high": "high"}


def file_tier(path, cfg):
    if any(matches(p, path) for p in ALWAYS_HIGH):
        return "high"
    user = cfg.get("risk") or {}
    for tier in ("high", "medium", "low"):
        if any(matches(p, path) for p in user.get(tier, [])):
            return tier
    for tier in ("medium", "low"):
        if any(matches(p, path) for p in DEFAULT_RISK[tier]):
            return tier
    return "medium"


def classify(files, cfg):
    per = {f: file_tier(f, cfg) for f in files}
    return max(per.values(), key=TIERS.index, default="low"), per


def base_ref(root, cfg):
    # LAND_IT_BASE first: in CI it's the pull request's base SHA, which no local guess can beat
    base = os.environ.get("LAND_IT_BASE") or cfg.get("base") or git(
        root, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD", check=False)
    return base or next((b for b in ("main", "master") if git(root, "rev-parse", "--verify", "--quiet", b, check=False)), "")


def merge_base(root, cfg):
    base = base_ref(root, cfg)
    return git(root, "merge-base", "HEAD", base, check=False) if base else ""


REVERTS_COMMIT = re.compile(r"This reverts commit ([0-9a-f]{7,40})")
REVERT = re.compile(r'^Revert "|' + REVERTS_COMMIT.pattern, re.M)
BREAKER = {"revert_rate": 0.05, "days": 14, "min_commits": 20, "mode": "observe"}


def revert_rate(root, cfg, days):
    """Reverts among first-parent commits on the base branch: one unit per merged change."""
    base = base_ref(root, cfg)
    out = git(root, "log", "--first-parent", "--since=%d.days" % days, "--format=%B%x1e", base, check=False) if base else ""
    msgs = [m for m in out.split("\x1e") if m.strip()]
    reverts = sum(bool(REVERT.search(m)) for m in msgs)
    return {"commits": len(msgs), "reverts": reverts, "rate": round(reverts / len(msgs), 3) if msgs else None}


def breaker(root, cfg):
    """The article's open gap: tighten review when reverts rise. In "enforce" mode a tripped breaker raises
    the floor one tier; the default "observe" only reports it, until the team decides to act on it."""
    conf = cfg.get("circuit_breaker")
    if conf is False:
        return None
    conf = dict(BREAKER, **(conf or {}))
    r = revert_rate(root, cfg, conf["days"])
    r.update(days=conf["days"], threshold=conf["revert_rate"],
             mode=conf["mode"], tripped=r["commits"] >= conf["min_commits"]
             and r["reverts"] > conf["revert_rate"] * r["commits"])  # the exact rate, not the rounded one
    return r


def floor_tier(root, cfg):
    tier, per = classify(changed_files_or_die(root, cfg), cfg)
    b = breaker(root, cfg)
    if b and b["tripped"] and b["mode"] == "enforce" and per:
        tier = TIERS[min(TIERS.index(tier) + 1, len(TIERS) - 1)]
    return tier, per, b


def changed_files(root, cfg):
    """Files that differ from the merge base, uncommitted and untracked included. None when there's no base:
    a diff that can't be computed must never read as an empty, low-risk one."""
    base = merge_base(root, cfg)
    if not base:
        return None
    untracked = nul_paths(git(root, "ls-files", "-z", "--others", "--exclude-standard", check=False, raw=True))
    return sorted(set(diff_paths(root, base) + untracked))


def changed_files_or_die(root, cfg):
    files = changed_files(root, cfg)
    if files is None:
        die("can't find the base branch to compare with (tried %s); set \"base\" in %s"
            % (cfg.get("base") or "origin/HEAD, main, master", CONFIG))
    return files


def cmd_risk(root, cfg, a):
    tier, per, b = floor_tier(root, cfg)
    effort = dict(REVIEW_EFFORT, **(cfg.get("review_effort") or {}))
    print(json.dumps({"tier": tier, "files": per, "review_effort": effort, "circuit_breaker": b}, indent=1))


# --- review rounds and findings, per branch -------------------------------------

def ledger_name(root):
    branch = git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False) or "unborn"
    return "ledger-%s.json" % re.sub(r"[^\w.-]", "_", branch)


STAGES = ["simplify", "code", "security", "verify"]
REQUIRED_STAGES = {"low": ["code"], "medium": ["code", "security"], "high": ["code", "security", "verify"]}


def stage_done(kind, rec):
    """A required stage must have completed; verify may also be not_run with a reason (nothing runnable)."""
    return bool(rec) and (rec["status"] == "completed" or (kind == "verify" and rec["status"] == "not_run"
                                                          and bool(rec.get("reason"))))


def cmd_stage(root, cfg, a):
    if a.status != "completed" and not a.reason:
        die("--status %s needs --reason" % a.status)
    with locked_state(root, ledger_name(root)) as led:
        rounds = led.get("rounds") or []
        if not rounds:
            die("no review round yet; run `land-it round` first")
        rounds[-1].setdefault("stages", {})[a.kind] = {"status": a.status, "reason": a.reason or "", "effort": a.effort,
                                                        "tree": worktree_tree(root), "at": int(time.time())}
    print(json.dumps({"round": rounds[-1]["n"], "stages": rounds[-1]["stages"]}, indent=1))


def cmd_round(root, cfg, a):
    tree, head = worktree_tree(root), git(root, "rev-parse", "HEAD", check=False)
    with locked_state(root, ledger_name(root)) as led:
        if a.reset:
            led.clear()
            print(json.dumps({"reset": True}))
            return
        rounds = led.setdefault("rounds", [])
        fresh = not rounds or rounds[-1]["tree"] != tree
        if fresh:
            # a dangling commit of the worktree, so later rounds can name an exact range
            snap = git(root, "commit-tree", tree, "-m", "land-it review snapshot", *(["-p", head] if head else []))
            rounds.append({"n": len(rounds) + 1, "tree": tree, "snap": snap, "at": int(time.time())})
    cur, prev = rounds[-1], (rounds[-2] if len(rounds) > 1 else None)
    cap = cfg.get("max_rounds", 3)
    print(json.dumps({
        "round": cur["n"],
        "max_rounds": cap,
        "over_cap": cur["n"] > cap,
        # true only when this exact tree's code review finished: a started round proves nothing
        "reviewed": not fresh and stage_done("code", (cur.get("stages") or {}).get("code")),
        "stages": cur.get("stages") or {},
        # round 1 reviews the whole change; later rounds only what changed since the previous one
        "target": "%s..%s" % (prev["snap"], cur["snap"]) if prev else "",
    }, indent=1))


def introduced(root, path, line, base):
    """Blame's hint for a finding: "before" (the line is already on the base), "this-change", or "unknown".
    Only a hint: an old line can become a bug because of new code that now reaches it."""
    m = re.match(r"\d+", str(line or ""))
    if not (base and m):
        return "unknown"
    out = git(root, "blame", "--porcelain", "-L", "%s,%s" % (m.group(), m.group()), "--", path, check=False)
    sha = out.split(" ", 1)[0]
    if not sha:
        return "unknown"
    if set(sha) == {"0"}:
        return "this-change"
    old = subprocess.run(["git", "merge-base", "--is-ancestor", sha, base], cwd=root).returncode == 0
    return "before" if old else "this-change"


def cmd_findings(root, cfg, a):
    name = ledger_name(root)
    if a.action == "add":
        new, base = json.load(sys.stdin), merge_base(root, cfg)
        with locked_state(root, name) as led:
            fs, added = led.setdefault("findings", []), []
            seen = {(x["file"], x["summary"].strip().lower()) for x in fs}
            for f in new:
                path = os.path.relpath(os.path.join(root, f["file"]), root)
                key = (path, f["summary"].strip().lower())
                if key in seen:
                    continue  # never post the same finding twice
                seen.add(key)
                item = {"id": "F%d" % (len(fs) + 1), "round": len(led.get("rounds", [])) or 1, "file": path,
                        "line": f.get("line"), "summary": f["summary"], "severity": f.get("severity", "important"),
                        "status": "open", "introduced": introduced(root, path, f.get("line"), base),
                        "reason": "", "thread": f.get("thread")}
                fs.append(item)
                added.append(item)
        print(json.dumps(added, indent=1))
    elif a.action == "resolve":
        if not (a.id and a.status):
            die("usage: land-it findings resolve F3 --status fixed|wontfix|pre-existing|open [--reason ...]")
        if a.status in ("wontfix", "pre-existing") and not a.reason:
            die("%s needs --reason (for pre-existing: why the defect isn't this change's)" % a.status)
        with locked_state(root, name) as led:
            item = next((x for x in led.get("findings", []) if x["id"] == a.id), None)
            if item is None:
                die("no finding %s" % a.id)
            item["status"], item["reason"] = a.status, a.reason or ""
        print(json.dumps(item, indent=1))
    else:
        led = load_state(root, name)
        print(json.dumps({"rounds": len(led.get("rounds", [])), "findings": led.get("findings", [])}, indent=1))


# --- checks ------------------------------------------------------------------

def check_specs(cfg):
    """checks: name -> "command" or {"run": "command", "paths": [globs]}"""
    for name, spec in (cfg.get("checks") or {}).items():
        spec = {"run": spec} if isinstance(spec, str) else spec
        yield name, spec["run"], spec.get("paths")


def run_checks(root, cfg, only=None, files=None):
    """Run checks in order, stop at the first failure. A check with `paths` runs only when one of
    `files` matches them (files=None: always). -> (ok, names not run, log)"""
    specs, log, skipped = list(check_specs(cfg)), [], []
    for name, cmd, paths in specs:
        if only is not None and name not in only:
            skipped.append(name)
            continue
        if paths and files is not None and not any(matches(p, f) for p in paths for f in files):
            skipped.append(name)
            log.append("== %s: skipped, no changed file under %s" % (name, ", ".join(paths)))
            continue
        t = time.time()
        r = subprocess.run(cmd, shell=True, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        verdict = "PASS" if r.returncode == 0 else "FAIL (exit %d)" % r.returncode
        log.append("== %s: %s\n%s== %s: %s in %.1fs" % (name, cmd, r.stdout, name, verdict, time.time() - t))
        if r.returncode:
            return False, skipped, "\n".join(log)
    if not specs:
        log.append("== no checks configured in %s" % CONFIG)
    return True, skipped, "\n".join(log)


def cmd_check(root, cfg, a):
    if not is_trusted(root, cfg):
        die(untrusted_message(cfg))
    before = worktree_tree(root)
    # checks skipped by `paths` don't apply to this change (no base: run them all), so a pass still means green
    ok, _, log = run_checks(root, cfg, files=changed_files(root, cfg))
    print(log)
    after = worktree_tree(root)
    with locked_state(root) as st:
        if ok and before == after:
            st["green"] = after
        else:  # a red run, or one that changed the tree under it, proves nothing about this tree
            st.pop("green", None)
            if (st.get("stamp") or {}).get("tree") in (before, after):
                st.pop("stamp", None)
    if ok and before != after:
        print("== land-it: the checks changed files (a formatter or fixer among them, or an edit meanwhile); "
              "look at the change and run check again")
        sys.exit(1)
    if ok:
        print("== land-it: all checks green for tree %s" % after[:12])
    sys.exit(0 if ok else 1)


def cmd_stamp(root, cfg, a):
    tree, now = worktree_tree(root), int(time.time())
    floor, _, b = floor_tier(root, cfg)
    tier = a.tier or floor
    if TIERS.index(tier) < TIERS.index(floor):
        die("tier %s is below %s from the changed paths%s: a tier can be raised, never lowered"
            % (tier, floor, " and the tripped circuit breaker" if b and b["tripped"] and b["mode"] == "enforce" else ""))
    led = load_state(root, ledger_name(root))
    fs, rounds = led.get("findings", []), led.get("rounds", [])
    unanswered = [x["id"] for x in fs if x["status"] == "open"]
    if unanswered:
        die("unanswered findings %s: resolve each one (fixed, or wontfix / pre-existing --reason)" % ", ".join(unanswered))
    required = dict(REQUIRED_STAGES, **(cfg.get("required_stages") or {})).get(tier, [])
    stages = (rounds[-1].get("stages") or {}) if rounds else {}
    missing = [k for k in required if not stage_done(k, stages.get(k))]
    if missing:
        die("a %s-tier change needs these review stages first: %s. Run each, then record it with "
            "`land-it stage <kind> --status completed`" % (tier, ", ".join(missing)))
    reviewed_tree = rounds[-1]["tree"] if rounds else None
    with locked_state(root) as st:
        if st.get("green") != tree:
            die("checks are not green for the current tree; run `land-it check` first")
        st["stamp"] = {"tree": tree, "tier": tier, "at": now, "base": merge_base(root, cfg),
                       "reviewed_tree": reviewed_tree, "stages": stages}
    record_run(root, {
        "at": now, "branch": git(root, "rev-parse", "--abbrev-ref", "HEAD", check=False), "tier": tier,
        "rounds": len(rounds), "minutes": round((now - rounds[0]["at"]) / 60, 1) if rounds else None,
        "findings": {s: sum(x["status"] == s for x in fs) for s in ("fixed", "wontfix", "pre-existing")},
        "breaker": bool(b and b["tripped"]),
    })
    print(json.dumps({"stamped": tree, "tier": tier, "changed_after_review": reviewed_tree != tree,
                      "pr_body": os.path.join(state_dir(root), "pr-body.md")}, indent=1))


# --- stats: the article's numbers for this repo ----------------------------------------

def runs_path(root):
    common = git(root, "rev-parse", "--git-common-dir")
    return os.path.join(root if not os.path.isabs(common) else "", common, "land-it", "runs.jsonl")


def record_run(root, rec):
    """One line per stamp, shared by all worktrees; stats keep the last one per branch."""
    path = runs_path(root)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps(rec) + "\n")


def pct(x, n):
    return round(100.0 * x / n) if n else None


def median(xs):
    xs = sorted(x for x in xs if x is not None)
    mid = len(xs) // 2
    return (xs[mid] if len(xs) % 2 else (xs[mid - 1] + xs[mid]) / 2) if xs else None


def quantile(xs, q):
    xs = sorted(x for x in xs if x is not None)
    return xs[min(len(xs) - 1, int(q * len(xs)))] if xs else None


def iso_ts(s):
    return datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def is_human(author):
    # `gh pr list` drops the [bot] suffix (the Claude app shows up as "claude"), so ask GraphQL for __typename
    login = (author or {}).get("login") or ""
    return bool(login) and author.get("__typename") != "Bot" and not login.endswith("[bot]")


MERGED_PRS = """query($q: String!, $endCursor: String) {
  search(query: $q, type: ISSUE, first: 50, after: $endCursor) {
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest { title createdAt mergedAt
      reviews(first: 100) { nodes { state body author { __typename login } comments { totalCount } } }
      comments(first: 100) { nodes { author { __typename login } } } } }
  }
}"""


def github_stats(root, days):
    since = time.strftime("%Y-%m-%d", time.gmtime(time.time() - days * DAY))
    r = gh_run(root, "api", "graphql", "--paginate", "-f", "query=" + MERGED_PRS,
               "-F", "q=repo:{owner}/{repo} is:pr is:merged merged:>=" + since, "--jq", ".data.search.nodes[]")
    if r.returncode:
        return {"error": tail(r.stderr.strip(), 300)}
    prs = [json.loads(ln) for ln in r.stdout.splitlines() if ln.strip()]
    nodes = lambda pr, key: (pr.get(key) or {}).get("nodes") or []
    approvals = [len({rv["author"]["login"] for rv in nodes(pr, "reviews")
                      if rv.get("state") == "APPROVED" and is_human(rv.get("author"))}) for pr in prs]
    comments = [sum(is_human(c.get("author")) for c in nodes(pr, "comments"))
                + sum(is_human(rv.get("author")) and bool((rv.get("body") or "").strip()) for rv in nodes(pr, "reviews"))
                + sum(((rv.get("comments") or {}).get("totalCount") or 0) for rv in nodes(pr, "reviews")
                      if is_human(rv.get("author")))
                for pr in prs]
    hours = [round((iso_ts(pr["mergedAt"]) - iso_ts(pr["createdAt"])) / 3600, 1) for pr in prs if pr.get("mergedAt")]
    return {
        "merged_prs": len(prs),
        "approvals_per_pr": {"median": median(approvals), "p95": quantile(approvals, .95)},
        "merged_without_approval_pct": pct(sum(a == 0 for a in approvals), len(prs)),
        "human_comments_per_pr": {"median": median(comments), "p95": quantile(comments, .95)},
        "hours_to_merge": {"median": median(hours), "p95": quantile(hours, .95)},
        "revert_prs_pct": pct(sum(pr["title"].startswith("Revert") for pr in prs), len(prs)),
    }


def cmd_stats(root, cfg, a):
    since, runs = time.time() - a.days * DAY, {}
    if os.path.exists(runs_path(root)):
        with open(runs_path(root)) as f:
            for ln in f:
                if ln.strip():
                    rec = json.loads(ln)
                    if rec["at"] >= since:
                        runs[rec["branch"]] = rec  # re-stamps of one change count once: the last
    rs, cap = list(runs.values()), cfg.get("max_rounds", 3)
    found = {s: sum(r["findings"].get(s, 0) for r in rs) for s in ("fixed", "wontfix", "pre-existing")}
    total = sum(found.values())
    out = {
        "days": a.days,
        "preflight": {
            "changes": len(rs),
            "one_round_pct": pct(sum(r["rounds"] <= 1 for r in rs), len(rs)),
            "mean_rounds": round(sum(r["rounds"] for r in rs) / len(rs), 2) if rs else None,
            "hit_round_cap_pct": pct(sum(r["rounds"] > cap for r in rs), len(rs)),
            "tiers": {t: sum(r["tier"] == t for r in rs) for t in TIERS},
            "median_minutes": median([r.get("minutes") for r in rs]),
        },
        "findings": {"total": total, "fixed_pct": pct(found["fixed"], total), "wontfix_pct": pct(found["wontfix"], total),
                     "pre_existing_pct": pct(found["pre-existing"], total)},
        "base_branch": dict(revert_rate(root, cfg, a.days), branch=base_ref(root, cfg)),
        "circuit_breaker": breaker(root, cfg),
    }
    if a.github:
        out["github"] = github_stats(root, a.days)
    print(json.dumps(out, indent=1))


def cmd_status(root, cfg, a):
    st, tree, head = load_state(root), worktree_tree(root), head_tree(root)
    stamp = st.get("stamp") or {}
    print(json.dumps({
        "checks": list((cfg.get("checks") or {}).keys()),
        "commands_trusted": is_trusted(root, cfg),
        "checks_green_for_worktree": st.get("green") == tree,
        "stamp_matches_worktree": stamp.get("tree") == tree,
        "stamp_matches_head": bool(head) and stamp.get("tree") == head,
        "stamp_tier": stamp.get("tier"),
        "state_dir": state_dir(root),
    }, indent=1))


# --- evals: past incidents become test cases for the reviewer ------------------------

EVAL_DIR = ".land-it/evals"
GUIDANCE = ["CLAUDE.md", "REVIEW.md", CONFIG]  # what a reviewer change usually edits
READ_ONLY_TOOLS = "Read,Grep,Glob,Agent,Bash(git diff *),Bash(git log *),Bash(git show *),Bash(git blame *)"
LOC = re.compile(r"([\w@+-][\w./@+-]*\.\w+):(\d+)")


def eval_cases(root):
    d = os.path.join(root, EVAL_DIR)
    cases = []
    for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if name.endswith(".json"):
            with open(os.path.join(d, name)) as f:
                cases.append(json.load(f))
    return cases


def eval_add(root, cfg, a):
    if not (a.range or a.commit):
        die("eval add needs --commit SHA or --range A..B")
    if not a.clean and not (a.file and a.line and a.summary):
        die("a bug case needs --file, --line (N or N-M) and --summary; --clean marks a known-good change")
    start, _, end = (a.range or "%s^..%s" % (a.commit, a.commit)).partition("..")
    rng = "%s..%s" % (git(root, "rev-parse", start), git(root, "rev-parse", end))
    cid = a.id or rng[-40:][:10]
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", cid):
        die("eval id %r: use letters, digits, '.', '_' or '-' (it becomes a file name)" % cid)
    path = os.path.join(root, EVAL_DIR, cid + ".json")
    case = {"id": cid, "range": rng, "kind": "clean" if a.clean else "bug", "expect": [],
            "note": a.note or "", "added": time.strftime("%Y-%m-%d")}
    if os.path.exists(path):
        with open(path) as f:
            case = json.load(f)
        if case["range"] != rng or case["kind"] != ("clean" if a.clean else "bug"):
            die("case %s already exists for another range or kind; pass --id" % cid)
    if not a.clean:
        m = re.fullmatch(r"(\d+)(?:-(\d+))?", a.line.strip())
        lo, hi = (int(m.group(1)), int(m.group(2) or m.group(1))) if m else (0, 0)
        if not (1 <= lo <= hi):
            die("--line %r: use N or N-M with 1 <= N <= M" % a.line)
        case["expect"].append({"file": a.file, "lines": [lo, hi], "summary": a.summary})
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(case, f, indent=1)
    print(json.dumps(case, indent=1))


def overlay(wt, rel, src):
    """Copy src to wt/rel without following a symlink the old commit may have put there. False if unsafe."""
    dst, top = os.path.join(wt, rel), os.path.realpath(wt)
    parent = os.path.dirname(dst)
    os.makedirs(parent, exist_ok=True)
    if not (os.path.realpath(parent) + os.sep).startswith(top + os.sep) and os.path.realpath(parent) != top:
        return False
    fd, tmp = tempfile.mkstemp(dir=parent, prefix=".land-it-")
    with os.fdopen(fd, "wb") as f, open(src, "rb") as s:
        shutil.copyfileobj(s, f)
    os.replace(tmp, dst)  # rename replaces a symlink at dst itself, never its target
    return True


def run_reviewer(wt, rng, a):
    if a.reviewer:
        cmd, shell = a.reviewer.replace("{range}", shlex.quote(rng)).replace("{effort}", a.effort), True
    else:
        cmd, shell = ["claude", "-p", "/code-review %s %s" % (a.effort, rng), "--output-format", "text"], False
        cmd += (["--model", a.model] if a.model else []) + ["--allowedTools", READ_ONLY_TOOLS]
    try:
        r = subprocess.run(cmd, shell=shell, cwd=wt, capture_output=True, text=True, timeout=a.timeout)
    except subprocess.TimeoutExpired:
        return 124, "timed out after %ds" % a.timeout
    return r.returncode, r.stdout + ("\n" + r.stderr if r.returncode else "")


def same_file(x, y):
    x, y = x.removeprefix("./"), y.removeprefix("./")
    return x == y or x.endswith("/" + y) or y.endswith("/" + x)


def score(case, text, slack=5):
    # ponytail: a finding is any `file:line` the review cites, so context citations count as noise;
    # switch to a structured findings format if the noise number starts to mislead
    found = sorted({(m.group(1), int(m.group(2))) for m in LOC.finditer(text)})
    res = {"id": case["id"], "kind": case["kind"], "findings": len(found)}
    if case["kind"] == "bug":
        res["expected"] = len(case["expect"])
        res["caught"] = sum(any(same_file(f, e["file"]) and e["lines"][0] - slack <= n <= e["lines"][1] + slack
                                for f, n in found) for e in case["expect"])
    return res


JUDGE_PROMPT = """You grade a code review against a known answer. Reply with one JSON object and nothing else:
{"caught": <number>, "findings": <number>}
- "findings": how many distinct problems the review reports (0 if it says there is nothing to fix).
- "caught": how many of these known bugs the review reports: the same defect counts even if it is worded
  differently or cited at a nearby line; a vague hint at the area does not.
%s
REVIEW:
<<<
%s
>>>"""


def scorer_id(a):
    if not (a.judge or a.judge_cmd):
        return "cites"
    what = a.judge or "cmd:" + hashlib.sha1(a.judge_cmd.encode()).hexdigest()[:8]
    return "judge:%s:%s" % (what, hashlib.sha1(JUDGE_PROMPT.encode()).hexdigest()[:6])


def judge_score(case, text, a):
    """An LLM reads the review: the defect counts, not just a file:line citation near it."""
    known = "\n".join("  - %s lines %d-%d: %s" % (e["file"], e["lines"][0], e["lines"][1], e["summary"])
                      for e in case["expect"]) or "  (none: this is a known-good change, so caught is 0)"
    prompt = JUDGE_PROMPT % ("Known bugs:\n" + known, tail(text, 20000))
    cmd, shell = (a.judge_cmd, True) if a.judge_cmd else (
        ["claude", "-p", "--model", a.judge, "--max-turns", "1", "--output-format", "text"], False)
    with tempfile.TemporaryDirectory() as empty:  # the judge reads the review, not the code
        try:
            r = subprocess.run(cmd, shell=shell, cwd=empty, input=prompt, capture_output=True, text=True, timeout=300)
            if r.returncode:
                raise ValueError("judge exited %d" % r.returncode)
            got = json.loads(re.findall(r"\{[^{}]*\}", r.stdout)[-1])
            caught, findings = got["caught"], got["findings"]
            if not all(type(n) is int and n >= 0 for n in (caught, findings)) or caught > len(case["expect"]):
                raise ValueError("judge counts out of range")
        except (subprocess.TimeoutExpired, IndexError, ValueError, KeyError, TypeError) as e:
            return {"id": case["id"], "kind": case["kind"], "error": "judge gave no valid verdict (%s)" % e}
    res = {"id": case["id"], "kind": case["kind"], "findings": findings}
    if case["kind"] == "bug":
        res.update(expected=len(case["expect"]), caught=caught)
    return res


def verdict(cur, prev):
    if cur["errors"]:
        return "%d case(s) failed to run; fix that before comparing" % cur["errors"]
    if not prev:
        return "baseline recorded"
    if prev.get("scorer", "cites") != cur["scorer"]:
        return "scorer changed (%s -> %s): new baseline" % (prev.get("scorer", "cites"), cur["scorer"])
    if prev.get("corpus", prev["case_ids"]) != cur["corpus"] or prev["errors"]:
        return "case set changed: new baseline, compare from the next run"
    r0, r1, n0, n1 = prev["recall"] or 0, cur["recall"] or 0, prev["noise"], cur["noise"]
    if r1 != r0:
        return ("better: recall %.0f%% -> %.0f%%, keep the change" if r1 > r0 else
                "worse: recall %.0f%% -> %.0f%%, revert the reviewer change") % (r0 * 100, r1 * 100)
    if n0 is not None and n1 is not None and n1 != n0:
        return ("same recall, less noise (%.2f -> %.2f): keep the change" if n1 < n0 else
                "same recall, more noise (%.2f -> %.2f): revert unless the extra findings are real") % (n0, n1)
    return "no change"


def eval_run(root, cfg, a):
    cases = [c for c in eval_cases(root) if not a.only or c["id"] in a.only]
    if not cases:
        die("no eval cases in %s; add one with `land-it eval add`" % EVAL_DIR)
    results, raw_dir = [], os.path.join(state_dir(root), "eval-runs", time.strftime("%Y%m%d-%H%M%S"))
    os.makedirs(raw_dir, exist_ok=True)
    for c in cases:
        tmp = tempfile.mkdtemp(prefix="land-it-eval-")
        wt = os.path.join(tmp, "wt")
        git(root, "worktree", "add", "--detach", "--quiet", wt, c["range"].split("..")[1])
        try:
            unsafe = [rel for rel in GUIDANCE  # the old change, reviewed under today's rules: that's what's tested
                      if os.path.exists(os.path.join(root, rel)) and not overlay(wt, rel, os.path.join(root, rel))]
            code, text = (1, "unsafe path in the old commit (a symlink out of the checkout): %s" % ", ".join(unsafe)
                          ) if unsafe else run_reviewer(wt, c["range"], a)
        finally:
            git(root, "worktree", "remove", "--force", wt, check=False)
            shutil.rmtree(tmp, ignore_errors=True)
        with open(os.path.join(raw_dir, c["id"] + ".txt"), "w") as f:  # to read why a case was missed
            f.write(text)
        if code:
            res = {"id": c["id"], "kind": c["kind"], "error": tail(text, 300)}
        else:
            res = judge_score(c, text, a) if (a.judge or a.judge_cmd) else score(c, text)
        results.append(res)
        print("%-14s %-5s %s" % (c["id"], c["kind"], res.get("error") or
              ("caught %d/%d, " % (res["caught"], res["expected"]) if c["kind"] == "bug" else "") +
              "%d finding(s)" % res["findings"]), flush=True)
    bugs = [r for r in results if r["kind"] == "bug" and "error" not in r]
    clean = [r for r in results if r["kind"] == "clean" and "error" not in r]
    expected = sum(r["expected"] for r in bugs)
    digest = hashlib.sha1()
    for rel in GUIDANCE:
        if os.path.exists(os.path.join(root, rel)):
            with open(os.path.join(root, rel), "rb") as f:
                digest.update(rel.encode() + b"\0" + f.read())
    run = {"at": time.strftime("%Y-%m-%dT%H:%M:%S"), "model": a.model or "default", "effort": a.effort,
           "reviewer": a.reviewer or "code-review", "guidance": digest.hexdigest()[:12],
           "scorer": scorer_id(a),
           # a case edited under the same id is a different corpus: fingerprint the content, not the ids
           "corpus": hashlib.sha1(json.dumps(cases, sort_keys=True).encode()).hexdigest()[:12],
           "case_ids": [c["id"] for c in cases], "errors": sum("error" in r for r in results),
           "recall": round(sum(r["caught"] for r in bugs) / expected, 3) if expected else None,
           "noise": round(sum(r["findings"] for r in clean) / len(clean), 2) if clean else None,
           "cases": results}
    summary = dict({k: run[k] for k in ("recall", "noise", "errors", "guidance")}, raw=raw_dir)
    if a.only:
        print(json.dumps(summary), "\npartial run (--only): not recorded in history")
        sys.exit(2 if run["errors"] else 0)
    hist = os.path.join(root, EVAL_DIR, "history.jsonl")
    prev = None
    if os.path.exists(hist):
        with open(hist) as f:
            lines = [ln for ln in f.read().splitlines() if ln.strip()]
        prev = json.loads(lines[-1]) if lines else None
    with open(hist, "a") as f:
        f.write(json.dumps(run) + "\n")
    print(json.dumps(summary), "\nverdict:", verdict(run, prev))
    sys.exit(2 if run["errors"] else 0)  # 2: a case failed to run, so the scores aren't trustworthy


def eval_list(root, cfg, a):
    for c in eval_cases(root):
        print("%-14s %-5s %s  %s" % (c["id"], c["kind"], c["range"][:7] + ".." + c["range"][-40:][:7],
                                     "; ".join("%s:%d %s" % (e["file"], e["lines"][0], e["summary"]) for e in c["expect"])))


def eval_scan(root, cfg, a):
    """Reverts on the base branch whose reverted commit isn't a case yet: incidents waiting to become evals."""
    have = {c["range"].split("..")[1] for c in eval_cases(root)}
    base = base_ref(root, cfg) or "HEAD"
    out = git(root, "log", base, "--since=%d.days" % a.days, "--format=%H%x1f%s%x1f%cs%x1f%B%x1e", check=False)
    found = []
    for rec in filter(str.strip, out.split("\x1e")):
        sha, subject, date, body = (rec.strip("\n").split("\x1f") + ["", "", ""])[:4]
        m = REVERTS_COMMIT.search(body)
        if m:
            reverted = git(root, "rev-parse", "--verify", "--quiet", m.group(1) + "^{commit}", check=False)
            reapply = reverted and REVERT.search(git(root, "log", "-1", "--format=%B", reverted, check=False))
            # not --first-parent: in merge-commit flows the "This reverts commit" line sits on the branch commit
            if reverted and not reapply and reverted not in have:
                found.append({"revert": sha, "reverted": reverted, "subject": subject, "date": date})
    print(json.dumps(found, indent=1))


def cmd_eval(root, cfg, a):
    {"add": eval_add, "run": eval_run, "list": eval_list, "scan": eval_scan}[a.action](root, cfg, a)


# --- GitHub review threads: every finding gets an answer, on the PR too ---------------

THREADS = """query($owner: String!, $repo: String!, $pr: Int!, $endCursor: String) {
  repository(owner: $owner, name: $repo) { pullRequest(number: $pr) {
    reviewThreads(first: 50, after: $endCursor) {
      pageInfo { hasNextPage endCursor }
      nodes { id isResolved isOutdated path line originalLine
        comments(first: 20) { nodes { author { __typename login } body url } } }
    } } }
}"""
REPLY = """mutation($id: ID!, $body: String!) {
  addPullRequestReviewThreadReply(input: {pullRequestReviewThreadId: $id, body: $body}) { comment { url } } }"""
RESOLVE = """mutation($id: ID!) { resolveReviewThread(input: {threadId: $id}) { thread { isResolved } } }"""


def gh_run(root, *args):
    return subprocess.run(["gh", *args], cwd=root, capture_output=True, text=True)


def gh(root, *args):
    r = gh_run(root, *args)
    if r.returncode:
        die("gh %s: %s" % (args[0], tail(r.stderr.strip(), 300)))
    return r.stdout


def graphql_payload(stdout, field):
    try:
        return (json.loads(stdout).get("data") or {}).get(field) or {}
    except ValueError:
        return {}


def resolve_thread(root, tid):
    r = gh_run(root, "api", "graphql", "-f", "query=" + RESOLVE, "-F", "id=" + tid)
    return r.returncode == 0 and bool(graphql_payload(r.stdout, "resolveReviewThread").get("thread"))


def cmd_threads(root, cfg, a):
    args = list(a.args)
    action = args.pop(0) if args and args[0] in ("list", "reply", "resolve") else "list"
    a.pr_or_id = args[0] if args else None
    if action == "resolve":
        if not (a.pr_or_id and resolve_thread(root, a.pr_or_id)):
            die("could not resolve thread %s" % a.pr_or_id)
        print(json.dumps({"resolved": True}, indent=1))
        return
    if action == "reply":
        if not (a.pr_or_id and a.body):
            die("usage: land-it threads reply THREAD_ID --body TEXT [--resolve]")
        out = gh(root, "api", "graphql", "-f", "query=" + REPLY, "-F", "id=" + a.pr_or_id, "-f", "body=" + a.body)
        url = (graphql_payload(out, "addPullRequestReviewThreadReply").get("comment") or {}).get("url")
        if not url:
            die("no reply posted: GitHub returned nothing for thread %s" % a.pr_or_id)
        if a.resolve and not resolve_thread(root, a.pr_or_id):
            # the reply is out; a retry of the whole command would post it twice
            die("replied at %s, but resolving failed; run `land-it threads resolve %s`, don't reply again"
                % (url, a.pr_or_id))
        print(json.dumps({"replied": url, "resolved": bool(a.resolve)}, indent=1))
        return
    m = re.search(r"(\d+)/?$", a.pr_or_id or gh(root, "pr", "view", "--json", "number", "-q", ".number").strip())
    if not m:
        die("not a pull request number: %s" % a.pr_or_id)
    pr = int(m.group(1))
    out = gh(root, "api", "graphql", "--paginate", "-f", "query=" + THREADS, "-F", "owner={owner}", "-F", "repo={repo}",
             "-F", "pr=" + str(pr), "--jq", ".data.repository.pullRequest.reviewThreads.nodes[]")
    threads = []
    for t in (json.loads(ln) for ln in out.splitlines() if ln.strip()):
        cs = (t.get("comments") or {}).get("nodes") or []
        if t.get("isResolved") or not cs:
            continue
        first = cs[0]
        threads.append({"id": t["id"], "path": t.get("path"), "line": t.get("line") or t.get("originalLine"), "outdated": t.get("isOutdated"),
                        "author": (first.get("author") or {}).get("login"), "bot": not is_human(first.get("author")),
                        "body": tail(first.get("body") or "", 1500), "replies": len(cs) - 1, "url": first.get("url")})
    print(json.dumps({"pr": pr, "unresolved": threads}, indent=1))


# --- sweep: the article's nightly agents, one area at a time ---------------------------

SWEEP_SKIP = {"docs", ".github", ".claude", ".land-it", "test", "tests", "vendor", "node_modules"}


def static_prefix(pattern):
    """The directory part of a glob before its first wildcard: src/billing/** -> src/billing."""
    parts = []
    for seg in pattern.strip("/").split("/"):
        if any(ch in seg for ch in "*?{["):
            break
        parts.append(seg)
    return "/".join(parts)


def sweep_area(root, pattern, files):
    """Where a risk.high glob points: its static prefix if that exists (src/billing/** -> src/billing),
    else the common parent of the files it matches (a slash-less "billing" -> src/billing). None if they share none."""
    hits = [f for f in files if matches(pattern, f)]
    prefix = static_prefix(pattern)
    if not hits:
        return None
    if prefix and os.path.exists(os.path.join(root, prefix)):
        return prefix
    return posixpath.commonpath(hits) or None


def cmd_sweep_target(root, cfg, a):
    files = nul_paths(git(root, "ls-files", "-z", raw=True))
    highs = (cfg.get("risk") or {}).get("high") or []
    cands = sorted(filter(None, (sweep_area(root, p, files) for p in highs)))
    cands = sorted(set(cands))
    source = "risk.high"
    if not cands:  # no high-risk paths configured: rotate over the top-level source directories
        cands = sorted({f.split("/", 1)[0] for f in files if "/" in f} - SWEEP_SKIP)
        source = "top-level directories"
    if not cands:
        die("nothing to sweep: no risk.high paths and no top-level directories")
    day = a.day if a.day is not None else time.gmtime().tm_yday
    print(json.dumps({"target": cands[day % len(cands)], "candidates": cands, "from": source}, indent=1))


# --- CI verdict: a commit status per pushed SHA, from recorded stages and findings ---------

CI_CONTEXT = "land-it/review"


def finding_mark(f):
    key = "%s\0%s" % (f["file"], re.sub(r"\s+", " ", f["summary"].strip().lower()))
    return "<!-- land-it:%s -->" % hashlib.sha1(key.encode()).hexdigest()[:12]


def publish_findings(root, pr, sha, findings):
    """Inline comments for findings not posted on this PR before; ones GitHub can't anchor go in one summary."""
    posted = gh(root, "api", "--paginate", "repos/{owner}/{repo}/pulls/%s/comments" % pr, "--jq", ".[].body")
    posted += gh(root, "api", "--paginate", "repos/{owner}/{repo}/issues/%s/comments" % pr, "--jq", ".[].body")
    new, unanchored = [f for f in findings if finding_mark(f) not in posted], []
    for f in new:
        body = "**%s** · land-it\n\n%s\n\n%s" % (f["severity"].capitalize(), f["summary"], finding_mark(f))
        line = re.match(r"\d+", str(f.get("line") or ""))
        r = gh_run(root, "api", "repos/{owner}/{repo}/pulls/%s/comments" % pr, "-f", "body=" + body,
                   "-f", "commit_id=" + sha, "-f", "path=" + f["file"], "-F", "line=%s" % (line.group() if line else 0),
                   "-f", "side=RIGHT") if line else None
        if not r or r.returncode:  # not on a changed line of this diff
            unanchored.append(f)
    if unanchored:
        gh(root, "api", "repos/{owner}/{repo}/issues/%s/comments" % pr, "-f", "body=" + "land-it findings outside the diff:\n\n"
           + "\n".join("- **%s** `%s:%s` %s %s" % (f["severity"].capitalize(), f["file"], f.get("line") or "?",
                                                   f["summary"], finding_mark(f)) for f in unanchored))
    return len(new)


def cmd_ci_verdict(root, cfg, a):
    tier, _, _ = floor_tier(root, cfg)
    led = load_state(root, ledger_name(root))
    rounds, fs = led.get("rounds") or [], led.get("findings") or []
    stages = (rounds[-1].get("stages") or {}) if rounds else {}
    # behavior checks are the repo's own CI; this verdict covers the review stages
    required = [k for k in dict(REQUIRED_STAGES, **(cfg.get("required_stages") or {})).get(tier, []) if k != "verify"]
    missing = [k for k in required if not stage_done(k, stages.get(k))]
    important = [f for f in fs if f["status"] == "open" and f.get("severity", "important") == "important"]
    if missing:
        state, desc = "error", "review didn't complete: %s" % ", ".join(missing)
    elif important:
        state, desc = "failure", "%d important finding(s) on this %s-tier change" % (len(important), tier)
    else:
        state, desc = "success", "%s-tier change reviewed (%s), no important findings" % (tier, ", ".join(required))
    posted = publish_findings(root, a.pr, a.sha, [f for f in fs if f["status"] == "open"]) if a.pr and not missing else 0
    if not a.dry_run:
        gh(root, "api", "repos/{owner}/{repo}/statuses/" + a.sha, "-f", "state=" + state, "-f", "context=" + CI_CONTEXT,
           "-f", "description=" + desc[:140])
    print(json.dumps({"state": state, "description": desc, "tier": tier, "sha": a.sha, "posted": posted}, indent=1))
    sys.exit({"success": 0, "failure": 1}.get(state, 2))


# --- hooks -------------------------------------------------------------------

def emit(obj):
    print(json.dumps(obj))
    sys.exit(0)


def prune(sessions, now):
    for sid in [s for s, e in sessions.items() if now - e.get("at", 0) > 7 * DAY]:
        del sessions[sid]


def settle(st, sid, tree):
    """The turn's changes are accounted for: later stops in this turn compare against `tree`."""
    st.setdefault("dirty", {}).pop(sid, None)
    st.setdefault("turn", {})[sid] = {"tree": tree, "at": int(time.time())}


def hook_prompt(data, root, cfg):
    """A new turn is judged on its own changes, so the user's edits between turns aren't Claude's."""
    if cfg.get("stop_gate") is False:
        return
    tree, now = worktree_tree(root), int(time.time())
    with locked_state(root) as st:
        prune(st.setdefault("turn", {}), now)
        settle(st, data.get("session_id", "?"), tree)


def hook_expand(data, root, cfg):
    """Trust is recorded only from a command the user typed: Claude invoking a skill doesn't fire this."""
    if data.get("command_name") != "land-it:trust":
        return
    record_trust(root, cfg)
    emit({"systemMessage": "land-it: commands trusted for %s" % root,
          "hookSpecificOutput": {"hookEventName": "UserPromptExpansion", "additionalContext":
                                 "land-it recorded the user's trust for these commands in %s:\n  %s"
                                 % (root, "\n  ".join(command_lines(cfg)) or "(none)")}})


def hook_post_edit(data, root, cfg):
    path = (data.get("tool_input") or {}).get("file_path")
    if not path:
        return
    path = os.path.join(data.get("cwd") or root, path)
    rel = os.path.relpath(os.path.realpath(path), os.path.realpath(root))
    if rel.startswith(".."):
        return
    sid, now = data.get("session_id", "?"), int(time.time())
    on_edit, trusted = cfg.get("on_edit") or {}, is_trusted(root, cfg)
    with locked_state(root) as st:
        dirty, warned = st.setdefault("dirty", {}), st.setdefault("warned", {})
        prune(dirty, now)
        prune(warned, now)
        entry = dirty.setdefault(sid, {"files": []})
        entry["at"] = now
        if rel not in entry["files"]:
            entry["files"].append(rel)
        first_warning = on_edit and not trusted and sid not in warned
        if first_warning:
            warned[sid] = {"at": now}
    if not trusted:
        if first_warning:  # once per session, not on every edit
            emit({"systemMessage": untrusted_message(cfg)})
        return
    problems = []
    for pat, cmd in on_edit.items():
        if matches(pat, rel) and os.path.exists(path):
            # the path goes in through the environment, so no quoting in the user's command can make it code
            cmd = cmd.replace("{file}", '"$LAND_IT_FILE"')
            r = subprocess.run(cmd, shell=True, cwd=root, env=dict(os.environ, LAND_IT_FILE=path),
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            if r.returncode:
                problems.append("$ %s\n%s" % (cmd, tail(r.stdout, 1500)))
    if problems:
        emit({"decision": "block", "reason": "land-it on_edit failed for %s; fix it before moving on:\n\n%s"
              % (rel, "\n\n".join(problems))})


def hook_stop(data, root, cfg):
    if cfg.get("stop_gate") is False:
        return
    sid = data.get("session_id", "?")
    st = load_state(root)
    entry = (st.get("dirty") or {}).get(sid) or {}
    base = ((st.get("turn") or {}).get(sid) or {}).get("tree")
    tree = worktree_tree(root)
    files = set(entry.get("files", []))
    if base and base != tree:  # the turn's snapshot also catches edits made through Bash
        files.update(diff_paths(root, base, tree))
    if not files or st.get("green") == tree or entry.get("red") == tree:
        # nothing changed this turn, or already green, or red on this exact tree: Claude saw the
        # failure and chose to stop (e.g. to ask the user), and re-running would change nothing
        return
    if all(file_tier(f, cfg) == "low" for f in files) or not is_trusted(root, cfg):
        with locked_state(root) as st:  # docs-only turn: nothing for the checks to prove
            settle(st, sid, tree)
        if not is_trusted(root, cfg):
            emit({"systemMessage": untrusted_message(cfg)})
        return
    ok, skipped, log = run_checks(root, cfg, cfg.get("stop_checks"), files=sorted(files))
    with locked_state(root) as st:
        if ok:
            settle(st, sid, tree)
            if not skipped:  # a subset passing doesn't make the whole tree green
                st["green"] = tree
        else:
            e = st.setdefault("dirty", {}).setdefault(sid, {"files": sorted(files)})
            e["at"], e["red"], e["blocks"] = int(time.time()), tree, e.get("blocks", 0) + 1
            blocks = e["blocks"]
    if ok:
        emit({"systemMessage": "land-it: checks green after this turn's changes"})
    if blocks > MAX_STOP_BLOCKS:
        emit({"systemMessage": "land-it: checks still red after %d tries; over to you.\n%s" % (MAX_STOP_BLOCKS, tail(log, 800))})
    emit({"decision": "block", "reason":
          "land-it: checks fail after your changes. Fix them, re-run, and show the output; "
          "don't report done on a red tree. If you are deliberately pausing (to ask the user), "
          "say so and stop again without changes.\n\n" + tail(log)})


# ponytail: text patterns, not a shell parser; they catch the usual forms. Enforcement that has to hold
# belongs in GitHub (branch protection, required checks), which these gates only mirror.
GH_PR = r"\bgh(?:\s+(?:-R|--repo)(?:=|\s+)\S+)?\s+pr\s+"
GH_PR_CREATE = re.compile(GH_PR + r"create\b")
GH_PR_MERGE = re.compile(GH_PR + r"merge\b([^;&|\n]*)")
GH_PR_APPROVE = re.compile(GH_PR + r"review\b[^;&|\n]*(?:--approve|\s-a\b)")
TRUST_CMD = re.compile(r"land-it\S*\s+(?:trust|hook)\b|\.land-it/trust\.json")
# Gates the wrapper because land-it's skills pre-approve `Bash(land-it *)`. A direct `gh api` or `gh pr comment`
# isn't pre-approved by them, so Claude Code's own permission prompt already covers it.
CI_VERDICT = re.compile(r"land-it\S*\s+ci-verdict\b")
THREAD_WRITE = re.compile(r"land-it\S*\s+threads\b[^;&|\n]*\b(?:reply|resolve)\b")


def decide(decision, reason):
    emit({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": decision,
                                 "permissionDecisionReason": reason}})


def hook_pre_bash(data, root, cfg):
    cmd = (data.get("tool_input") or {}).get("command") or ""
    create, merge, approve = GH_PR_CREATE.search(cmd), GH_PR_MERGE.search(cmd), GH_PR_APPROVE.search(cmd)
    trust, thread_write, ci_verdict = TRUST_CMD.search(cmd), THREAD_WRITE.search(cmd), CI_VERDICT.search(cmd)
    if not (create or merge or approve or trust or thread_write or ci_verdict):
        return
    # every deny before any ask: a combined command must not slip a deny past an ask's prompt
    if trust:
        decide("deny", "land-it: only the user can trust config commands, by typing /land-it:trust "
               "(and the hook entry point and the trust store aren't for Claude's shell).")
    if approve:
        decide("deny", "land-it: an agent's approval never counts as a person's. Approving a PR is for a human.")
    if ci_verdict:
        decide("deny", "land-it: the CI workflow sets the land-it/review status after the review, not Claude.")
    stamp, stamped_head = {}, False
    if create or merge:
        stamp = load_state(root).get("stamp") or {}
        stamped_head = bool(stamp.get("tree")) and stamp["tree"] == head_tree(root)
    if create and not stamped_head:
        decide("deny", "land-it: HEAD has no preflight stamp, or it changed after the stamp. Run /land-it:preflight "
               "(the stamp covers exactly the tree it checked), commit everything it checked, then create the PR. "
               "To skip deliberately, the user can run the command themselves.")
    asks = []
    if thread_write:
        asks.append("this replies to or resolves a review thread under your GitHub account")
    if merge:
        try:
            other_pr = [t for t in shlex.split(merge.group(1)) if not t.startswith("-")]
        except ValueError:
            other_pr = ["?"]
        if other_pr or not stamped_head or stamp.get("tier") != "low":
            tier = stamp.get("tier") if stamped_head else "unknown (no stamp for HEAD)"
            asks.append("merging a change of tier %s is a human call; an agent's approval never counts as a "
                        "person's, and only low-tier changes with green checks merge on automation alone" % tier)
    if asks:
        decide("ask", "land-it: " + "; ".join(asks) + ".")


HOOKS = {"post-edit": hook_post_edit, "stop": hook_stop, "pre-bash": hook_pre_bash,
         "prompt": hook_prompt, "expand": hook_expand}


def cmd_trust(root, cfg, a):
    """For a terminal outside Claude Code; inside it, the user types /land-it:trust."""
    if os.environ.get("CLAUDECODE") or not sys.stdin.isatty():
        die("trust needs you at a terminal; in Claude Code, type /land-it:trust instead")
    print("Commands in %s for %s:\n  %s" % (CONFIG, root, "\n  ".join(command_lines(cfg)) or "(none)"))
    if input("Trust these commands? [y/N] ").strip().lower() not in ("y", "yes"):
        die("not trusted")
    record_trust(root, cfg)
    print("trusted")


def run_hook(event):
    # Claude Code exports CLAUDE_PLUGIN_ROOT to hook processes, not to commands Claude runs through Bash.
    # Without this, `echo '{"command_name": "land-it:trust"}' | land-it hook expand` would let Claude trust itself.
    if not os.environ.get("CLAUDE_PLUGIN_ROOT"):
        die("`land-it hook` is the entry point for hooks/hooks.json; it doesn't run from a shell")
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    root = find_root(data.get("cwd") or os.getcwd())
    cfg = load_config(root) if root else None
    if cfg is not None:  # no config = land-it isn't set up in this repo: stay silent
        HOOKS[event](data, root, cfg)


def main(argv=None):
    p = argparse.ArgumentParser(prog="land-it", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("check", help="run configured checks; on success mark the tree green")
    sub.add_parser("risk", help="risk tier of the change vs the merge base, per file")
    r = sub.add_parser("round", help="start a review round: number, cap, and the diff-only target")
    r.add_argument("--reset", action="store_true", help="forget rounds and findings for this branch")
    f = sub.add_parser("findings", help="the branch's findings ledger: list, add (JSON on stdin), resolve")
    f.add_argument("action", nargs="?", default="list", choices=["list", "add", "resolve"])
    f.add_argument("id", nargs="?")
    f.add_argument("--status", choices=["fixed", "wontfix", "pre-existing", "open"])
    f.add_argument("--reason")
    sg = sub.add_parser("stage", help="record that a review stage of the current round ran (or why it didn't)")
    sg.add_argument("kind", choices=STAGES)
    sg.add_argument("--status", required=True, choices=["completed", "skipped", "not_run"])
    sg.add_argument("--reason")
    sg.add_argument("--effort")
    s = sub.add_parser("stamp", help="bind the green tree and its tier to a preflight stamp")
    s.add_argument("--tier", choices=TIERS, help="raise the tier above the path-based floor")
    sub.add_parser("status", help="show green/stamp state for the worktree and HEAD")
    sub.add_parser("trust", help="approve the config's commands (at your own terminal)")
    e = sub.add_parser("eval", help="reviewer evals from past incidents: list, add, run")
    e.add_argument("action", nargs="?", default="list", choices=["list", "add", "run", "scan"])
    e.add_argument("--commit", help="add: the commit that introduced the bug (reviewed as SHA^..SHA)")
    e.add_argument("--range", help="add: A..B, for a change spanning several commits")
    e.add_argument("--clean", action="store_true", help="add: a known-good change, for measuring noise")
    e.add_argument("--file")
    e.add_argument("--line", help="N or N-M")
    e.add_argument("--summary")
    e.add_argument("--note")
    e.add_argument("--id")
    e.add_argument("--only", nargs="+", help="run: these case ids (not recorded in history)")
    e.add_argument("--model")
    e.add_argument("--effort", default="high")
    e.add_argument("--reviewer", help="run: shell command instead of `claude -p /code-review`; "
                                      "{range} and {effort} are substituted")
    e.add_argument("--timeout", type=int, default=1800)
    e.add_argument("--judge", metavar="MODEL", help="run: score with an LLM judge (e.g. haiku) instead of file:line cites")
    e.add_argument("--days", type=int, default=365, help="scan: how far back to look for reverts")
    e.add_argument("--judge-cmd", help="run: shell command that reads the judge prompt on stdin and prints the JSON")
    th = sub.add_parser("threads", help="unresolved review threads on a PR; reply (and resolve) one")
    th.add_argument("args", nargs="*", metavar="PR | reply THREAD_ID | resolve THREAD_ID",
                    help="a PR number, #N or URL (default: this branch's PR), or `reply`/`resolve` and a thread id")
    th.add_argument("--body")
    th.add_argument("--resolve", action="store_true")
    cv = sub.add_parser("ci-verdict", help="CI: set the land-it/review status of a SHA from the recorded review")
    cv.add_argument("--sha", required=True)
    cv.add_argument("--pr", help="also post open findings on this pull request (deduplicated)")
    cv.add_argument("--dry-run", action="store_true", help="print the verdict without setting the status")
    sw = sub.add_parser("sweep-target", help="today's area for the nightly sweep, rotating over risk.high")
    sw.add_argument("--day", type=int, help="day number to rotate by (default: day of the year)")
    st = sub.add_parser("stats", help="the article's numbers: rounds, findings, reverts, and with --github human time")
    st.add_argument("--days", type=int, default=30)
    st.add_argument("--github", action="store_true", help="add merged-PR metrics from `gh`")
    h = sub.add_parser("hook", help="entry point for hooks/hooks.json")
    h.add_argument("event", choices=sorted(HOOKS))
    a = p.parse_args(argv)
    if a.cmd == "hook":
        return run_hook(a.event)
    root = find_root(os.getcwd()) or die("not inside a git repository")
    cfg = load_config(root)
    if cfg is None:
        die("no %s here; run /land-it:init" % CONFIG)
    {"check": cmd_check, "risk": cmd_risk, "round": cmd_round, "findings": cmd_findings, "stage": cmd_stage,
     "stamp": cmd_stamp, "status": cmd_status, "eval": cmd_eval, "trust": cmd_trust,
     "stats": cmd_stats, "threads": cmd_threads, "sweep-target": cmd_sweep_target,
     "ci-verdict": cmd_ci_verdict}[a.cmd](root, cfg, a)


if __name__ == "__main__":
    main()
