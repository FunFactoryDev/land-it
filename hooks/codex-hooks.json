{
  "description": "land-it for Codex: the CLI's path at session start, format/lint on edit, checks before the agent says done, preflight stamp before gh pr create, trust by typing `land-it trust`.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${PLUGIN_ROOT}/bin/land-it\" hook session --runtime codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 \"${PLUGIN_ROOT}/bin/land-it\" hook prompt --runtime codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 120,
            "command": "python3 \"${PLUGIN_ROOT}/bin/land-it\" hook post-edit --runtime codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 900,
            "command": "python3 \"${PLUGIN_ROOT}/bin/land-it\" hook stop --runtime codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 \"${PLUGIN_ROOT}/bin/land-it\" hook pre-bash --runtime codex"
          }
        ]
      }
    ]
  }
}
